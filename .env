# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Douyin Crawler Full Stack"
STACK_NAME=douyin-crawler-full-stack

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=55432
# Host-only port used by compose.override.yml to avoid clashing with an
# existing local PostgreSQL. Containers still talk to db:5432.
POSTGRES_HOST_PORT=55432
POSTGRES_DB=app
TEST_POSTGRES_DB=app_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
# Seconds to wait for a new database connection before failing fast.
POSTGRES_CONNECT_TIMEOUT=5

SENTRY_DSN=

# Douyin crawler (CDP only)
# 浏览器 / 账号会话 / 采集风控 / 互动 / 媒体 / 字幕的结构化配置已迁到仓库根目录的
# config.yaml（每一项都标注了对应的旧环境变量名）。这里只保留密钥、连接串与兼容项；
# 需要按环境临时覆盖时写回同名环境变量即可——环境变量优先于 config.yaml。
# 远程槽位仍支持旧的 JSON 形式（config.yaml 的 browser.slots.remote 非空时以 YAML 为准）：
DOUYIN_REMOTE_CDP_SLOTS={"pool-1":{"host":"douyin-browser-1","port":9222,"viewer_url":"http://127.0.0.1:6082/vnc.html?autoconnect=1&resize=scale"},"pool-2":{"host":"douyin-browser-2","port":9222,"viewer_url":"http://127.0.0.1:6083/vnc.html?autoconnect=1&resize=scale"},"pool-3":{"host":"douyin-browser-3","port":9222,"viewer_url":"http://127.0.0.1:6084/vnc.html?autoconnect=1&resize=scale"}}

# Video download and subtitle transcription/translation
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=mediacrawler
MINIO_SECRET_KEY=mediacrawler-secret
MINIO_SECURE=false
MINIO_BUCKET=douyin-media
MINIO_REGION=
# 转写服务的地址/模型/超时/并发/音频参数已迁到 config.yaml 的 subtitle 段，这里只留密钥
WHISPER_API_KEY=

# MCP gateway. Empty credentials reuse FIRST_SUPERUSER settings.
MCP_API_BASE_URL=http://127.0.0.1:8000/api/v1
MCP_API_USERNAME=
MCP_API_PASSWORD=
DOUYIN_MCP_TRANSPORT=stdio
DOUYIN_MCP_HOST=127.0.0.1
DOUYIN_MCP_PORT=8766
DOUYIN_MCP_PATH=/mcp

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
