{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动项目",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "启动项目"
        },
        {
            "name": "关闭项目",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "powershell.exe",
            "runtimeArgs": [
                "-NoProfile",
                "-Command",
                "Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { taskkill /PID $_ /T /F }"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
