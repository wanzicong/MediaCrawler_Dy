{
    // 打开文件时默认折叠 import 区域；折叠箭头始终显示
    "editor.foldingImportsByDefault": true,
    "editor.showFoldingControls": "always",
    // Auto Foldx 扩展：打开代码文件时自动折叠到最外层（需先安装 ljt990218.auto-fold）
    "autoFold.foldLevelOnOpen": [1],
    // 关闭 Tailwind 的「建议改用 v4 新类名」提示（旧写法 bg-gradient-* / break-words 等仍可用）
    "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
    // 侧边栏只保留源码：以下均为依赖、构建产物或测试报告，不属于源码
    "files.exclude": {
        "**/node_modules": true,
        "dist": true,
        "openapi.json": true,
        ".tanstack": true,
        "playwright": true,
        "playwright-report": true,
        "test-results": true,
        "blob-report": true,
        ".pytest_cache": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "logs": true,
        "**/*.log": true,
        "**/.DS_Store": true
    },
    // 全局搜索同样屏蔽这些路径，避免命中产物与报告里的噪声
    "search.exclude": {
        "**/node_modules": true,
        "dist": true,
        "openapi.json": true,
        ".tanstack": true,
        "playwright": true,
        "playwright-report": true,
        "test-results": true,
        "blob-report": true,
        ".pytest_cache": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "logs": true,
        "**/*.log": true,
        "**/.DS_Store": true
    }
}
